<footer class="footer sp-footer mt-auto py-4">
  <div class="container">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
      <%= link_to "https://www.fisheye.nz", target: "_blank", rel: "noopener noreferrer", class: "text-decoration-none", "aria-label": "Fisheye IT" do %>
        <%= image_tag "fisheye-wordmark-white.png", alt: "Fisheye", class: "sp-wordmark" %>
      <% end %>
      <div class="d-flex align-items-center gap-2">
        <span class="small">
          &copy; <%= Time.now.year %>
          <%= link_to "Fisheye IT", "https://www.fisheye.nz", target: "_blank", rel: "noopener noreferrer", class: "text-muted text-decoration-none" %>
          <% if Settings.show_version %>&middot; v<%= Version.current %><% end %>
          &middot; <%= link_to _('About'), page_path('about'), class: "text-decoration-none" %>
        </span>
      </div>

      <% if Settings.brand.show_footer_menu %>
        <nav class="d-flex flex-wrap gap-3 small">
          <%= link_to _('About').capitalize, page_path('about'), class: 'text-muted text-decoration-none' %>
          <%= link_to _('API'), help_api_path, class: 'text-muted text-decoration-none' %>
          <%= link_to _('Documentation').capitalize, "https://docs.pwpush.com", target: "_blank", rel: "noopener noreferrer", class: 'text-muted text-decoration-none' %>
          <%= link_to 'GitHub', "https://github.com/pglombardo/PasswordPusher", target: "_blank", rel: "noopener noreferrer", class: 'text-muted text-decoration-none' %>
        </nav>
      <% end %>
    </div>

    <% if Settings.brand.disclaimer %>
      <p class="text-muted small fst-italic text-center mt-3 mb-0"><%= Settings.brand.disclaimer %></p>
    <% end %>
  </div>
</footer>
