<%# SafePass: plain-English intro above the send box (requested by Jeremy and Rae, CW #786198). %>
<section class="card sp-card sp-intro mb-4" aria-labelledby="sp-intro-heading">
  <div class="card-body p-4">
    <div class="row g-4 align-items-center">
      <div class="col-lg-6">
        <h1 id="sp-intro-heading" class="h4 mb-2"><%= _('Send passwords safely, not by email') %></h1>
        <p class="mb-3"><%= _('SafePass is a free service from Fisheye for sending a password or other sensitive information. Instead of putting it in an email or chat, paste it here and send the private link SafePass gives you. The link only works for the number of days or views you choose, then the information is deleted for good.') %></p>
        <%= link_to page_path('about'), class: "btn btn-outline-primary btn-sm" do %>
          <em class="bi bi-info-circle me-1"></em><%= _('More info') %>
        <% end %>
      </div>
      <div class="col-lg-6">
        <ol class="sp-steps list-unstyled mb-0">
          <li><span class="sp-step-num">1</span><span><%= _('Paste the password or text in the box below.') %></span></li>
          <li><span class="sp-step-num">2</span><span><%= _('Choose how many days or views the link should last.') %></span></li>
          <li><span class="sp-step-num">3</span><span><%= _('Click Push It! and send the link to the person who needs it.') %></span></li>
        </ol>
      </div>
    </div>
  </div>
</section>
